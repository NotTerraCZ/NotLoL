<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK kvůli rozpoznávání textu (Windows.Media.Ocr) – čtení karet z obrazovky -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NotLoL</AssemblyName>
    <RootNamespace>NotLoL</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>NotLoL</Product>
    <Description>League of Legends tier list a buildy z dat u.gg</Description>
    <!-- Verze pro lokální build; vydání přes GitHub Actions ji přepíše verzí z tagu (v1.2.3 → 1.2.3) -->
    <Version>1.7.4</Version>

    <!-- Jeden .exe soubor (potřebuje .NET 10 Desktop Runtime). Instalátor a aktualizace balí Velopack (vpk). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- Balíček WebView2 přibaluje i WPF knihovnu, kterou nepoužíváme -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Webové rozhraní je zabalené přímo v .exe -->
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- Instalace a automatické aktualizace z GitHub Releases (stejná verze jako vpk v release.yml) -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
